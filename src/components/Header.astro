---
interface Props {
  active?: 'reviews' | 'thoughts' | 'about' | '';
}
const { active = '' } = Astro.props;
const links = [
  { key: 'reviews', href: '/reviews/', label: 'Trail Reviews' },
  { key: 'thoughts', href: '/thoughts/', label: 'Trail Thoughts' },
  { key: 'about', href: '/about/', label: 'About' },
];
---

<header class="site-header">
  <nav class="site-nav" aria-label="Main">
    <a class="brand" href="/">
      <span class="blaze-mark" aria-hidden="true"></span>
      <span>JaxTrails</span>
    </a>
    <div class="nav-links">
      {
        links.map((l) => (
          <a href={l.href} aria-current={active === l.key ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>
