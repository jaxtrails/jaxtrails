---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <svg aria-hidden="true" focusable="false">
    <defs>
      <pattern id="pines" x="0" y="0" width="60" height="90" patternUnits="userSpaceOnUse">
        <polygon
          points="30,4 42,30 35,30 48,54 40,54 52,80 34,80 34,90 26,90 26,80 8,80 20,54 12,54 25,30 18,30"
          fill="#1E2B24"></polygon>
      </pattern>
    </defs>
    <rect x="0" y="0" width="100%" height="90" fill="url(#pines)"></rect>
  </svg>
  <div class="footer-bar">
    <div>
      <span>&copy; {year} JaxTrails</span>
      <span>
        <a href="/reviews/">Trail Reviews</a> &middot; <a href="/thoughts/">Trail Thoughts</a> &middot;
        <a href="/about/">About</a>
      </span>
    </div>
  </div>
</footer>
