---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SampleTag from '../../components/SampleTag.astro';
import Blazes from '../../components/Blazes.astro';
import {
  categorySlug,
  fmtDate,
  getParks,
  getThoughts,
  getTrails,
  trailsForThought,
  type Thought,
} from '../../lib/content';
import BookCover from '../../components/BookCover.astro';
import EraBar from '../../components/EraBar.astro';
import { BOOKS, ERAS, SERIES, bookByNumber, getSeriesState, seriesUrl, splitTitle } from '../../lib/books';

export async function getStaticPaths() {
  const posts = await getThoughts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Thought };
const [parks, allTrails] = await Promise.all([getParks(), getTrails()]);
const parkIds = new Set(parks.map((p) => p.id));
const related = trailsForThought(post, allTrails).filter((t) => parkIds.has(t.data.park.id));
const catSlug = categorySlug(post.data.category);
const { Content } = await render(post);
const book = post.data.book ? bookByNumber(post.data.book) : undefined;
const inSeries = post.data.series === SERIES.slug;
const st = book ? await getSeriesState() : undefined;
const era = book ? ERAS[book.era - 1] : undefined;
const prev = book ? bookByNumber(book.n - 1) : undefined;
const next = book ? bookByNumber(book.n + 1) : undefined;
const sameEra = book ? BOOKS.filter((b) => b.era === book.era && b.n !== book.n).slice(0, 3) : [];
const link = (n: number) => { const r = st?.reviewByBook.get(n); return r ? `/thoughts/${r.id}/` : '/thoughts/series/america-250/shelf/'; };
---

<BaseLayout title={post.data.title} description={post.data.summary} active="thoughts">
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/thoughts/">Trail Thoughts</a>
    <span aria-hidden="true">&rsaquo;</span>
    <a href={`/thoughts/category/${catSlug}/`}>{post.data.category}</a>
    {inSeries && (<><span aria-hidden="true">&rsaquo;</span><a href={seriesUrl()}>America 250</a></>)}
  </nav>

  <header class="article-head">
    <div class="eyebrow">{post.data.category}</div>
    <h1>{post.data.title}<SampleTag show={post.data.sample} /></h1>
    <p class="standfirst">{post.data.summary}</p>
    <div class="label">{fmtDate(post.data.date)}</div>
  </header>

  {book && era && (
    <div class="book-head">
      <BookCover n={book.n} size="lg" />
      <div>
        <div class="label">Era {era.n} of 14 &middot; {era.name}</div>
        <EraBar readByEra={st!.readByEra} current={era.n} />
        <dl class="factbox">
          <div><dt>Author</dt><dd>{book.author}</dd></div>
          <div><dt>First published</dt><dd>{book.year}</dd></div>
          <div><dt>Era</dt><dd>{era.name}</dd></div>
          <div><dt>Type</dt><dd>{book.type}</dd></div>
          <div><dt>Length</dt><dd>About {book.pages} pages</dd></div>
          <div><dt>Book number</dt><dd>{book.n} of {SERIES.total}</dd></div>
        </dl>
      </div>
    </div>
  )}

  <div class="prose"><Content /></div>

  {book && (
    <>
      <nav class="prevnext" aria-label="Series navigation">
        {prev ? <a href={link(prev.n)}><span class="label">Previous</span>{splitTitle(prev.title).main}</a> : <span><span class="label">Previous</span>Start of the series</span>}
        {next ? <a href={link(next.n)}><span class="label">Next &middot; Book {next.n}</span>{splitTitle(next.title).main}</a> : <span><span class="label">Next</span>End of the series</span>}
      </nav>
      {sameEra.length > 0 && (
        <section class="related" style="max-width: 34em">
          <h2>More from this era</h2>
          <div class="links">{sameEra.map((b) => <a href={link(b.n)}>{splitTitle(b.title).main}<small>{b.author}</small></a>)}</div>
        </section>
      )}
    </>
  )}

  {
    related.length > 0 && (
      <section class="related" style="max-width: 34em">
        <h2>Related trail reviews</h2>
        <div class="links">
          {related.map((t) => (
            <a href={`/reviews/${t.data.park.id}/${t.id}/`}>
              {t.data.title}
              <small>
                {t.data.distance} &middot; {t.data.difficulty} &middot; <Blazes rating={t.data.rating} size="sm" />
              </small>
            </a>
          ))}
        </div>
      </section>
    )
  }

  <p style="margin-top: 40px">
    <a class="more" href={`/thoughts/category/${catSlug}/`}>&larr; More {post.data.category}</a>
  </p>
</BaseLayout>
