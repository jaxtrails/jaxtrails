---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostItem from '../../../components/PostItem.astro';
import EraBar from '../../../components/EraBar.astro';
import { CATEGORIES, getThoughts } from '../../../lib/content';
import { SERIES, getSeriesState, seriesUrl } from '../../../lib/books';

const all = await getThoughts();
const posts = all.filter((t) => t.data.category === 'Books');
const st = await getSeriesState();
---
<BaseLayout title="Books" description="Book reviews and reading series." active="thoughts">
  <section class="page-head"><h1 class="sign sign--right sign--page">Books</h1></section>
  <div class="chips" role="group" aria-label="Filter by subcategory">
    <a class="chip" href="/thoughts/">All</a>
    {CATEGORIES.map((c) => <a class="chip" href={`/thoughts/category/${c.slug}/`} aria-current={c.slug === 'books' ? 'true' : undefined}>{c.name}</a>)}
  </div>
  <div class="cols">
    <div class="main">
      <div class="section-title"><h2>Series</h2><span class="rule"></span></div>
      <a class="series-card" href={seriesUrl()}>
        <span class="usa-stripe"></span>
        <span class="series-body">
          <span class="usa-stars">&#9733; &#9733; &#9733;</span>
          <span class="series-name">{SERIES.name}</span>
          <EraBar readByEra={st.readByEra} />
          <span class="series-count">{st.readCount} of {SERIES.total} read</span>
          <span class="series-open">Open the series &rarr;</span>
        </span>
        <span class="usa-stripe"></span>
      </a>
      <div class="section-title" style="margin-top:48px"><h2>All book posts</h2><span class="rule"></span></div>
      {posts.length === 0 ? <p class="empty">Nothing here yet.</p> : posts.map((p) => <PostItem post={p} />)}
    </div>
    <aside class="side">
      <div class="panel">
        <div class="panel-title">Series</div>
        <div class="links"><a href={seriesUrl()}>{SERIES.name}<small>{st.readCount} of {SERIES.total} read</small></a></div>
      </div>
      <div class="panel">
        <div class="panel-title">All writing</div>
        <div class="links"><a href="/thoughts/">Trail Thoughts<small>Every post in one list.</small></a></div>
      </div>
    </aside>
  </div>
</BaseLayout>
